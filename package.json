{
  "name": "pure-svg-charts",
  "version": "0.1.0",
  "description": "Ultra-lightweight, reactive, and animated SVG charts for React",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run test && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmarks:install": "npm --prefix benchmarks install",
    "benchmarks:dev": "npm --prefix benchmarks run dev",
    "benchmarks:build": "npm --prefix benchmarks run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GabrielBaiano/pure-svg-charts.git"
  },
  "bugs": {
    "url": "https://github.com/GabrielBaiano/pure-svg-charts/issues"
  },
  "homepage": "https://github.com/GabrielBaiano/pure-svg-charts#readme",
  "keywords": [
    "react",
    "svg",
    "charts",
    "lightweight",
    "animated",
    "graphs",
    "data-visualization"
  ],
  "author": "Gabriel Baiano <gabrielngama@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.9",
    "@codemirror/lang-javascript": "^6.2.5",
    "@testing-library/react": "^16.3.3",
    "@types/babel__standalone": "^7.1.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@uiw/codemirror-theme-tokyo-night": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "terser": "^5.51.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^5.0.1"
  }
}
